# Module L: Celery worker service container. Same app code, same
# requirements.txt as the existing (non-containerized) dev setup — no
# runtime behavior change from Dockerizing this service.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["celery", "-A", "app.worker.celery_app", "worker", "--loglevel=info"]
