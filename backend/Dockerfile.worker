# Module L: Celery worker service container. Same app code, same
# requirements.txt as the existing (non-containerized) dev setup — no
# runtime behavior change from Dockerizing this service.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Issue #17: a Celery worker with no -Q flag only consumes the default
# "celery" queue -- since process_evidence_document_task now routes to
# its own "documents" queue (app/worker/celery_app.py's task_routes),
# consuming both here keeps this single-process image correct for a
# one-worker deployment (docker-compose.yaml's own worker service).
# k8s/worker-documents-deployment.yaml overrides this command to -Q
# documents only, scaled independently from the default-queue worker.
CMD ["celery", "-A", "app.worker.celery_app", "worker", "--loglevel=info", "-Q", "celery,documents"]
