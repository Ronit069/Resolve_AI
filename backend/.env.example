PROJECT_NAME="ResolveAI Foundation"
POSTGRES_USER="your_db_user"
POSTGRES_PASSWORD="your_db_password"
POSTGRES_DB="your_db_name"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

REDIS_URL="redis://localhost:6379/0"

S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="your_minio_access_key"
S3_SECRET_KEY="your_minio_secret_key"
S3_BUCKET_NAME="evidence-bucket"

API_SECRET_KEY="your_secret_key_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
ENABLE_DEV_ENDPOINTS=False

# Module I: exact origin the frontend is served from (no wildcard)
CORS_ALLOWED_ORIGIN="http://localhost:5173"

# Module J, Category D: Razorpay external API credentials (global, not per-merchant)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_ALLOW_LIVE_MODE=False
