PROJECT_NAME="ResolveAI Foundation"
# These Postgres/MinIO values are not placeholders to swap out for local
# dev -- they must match docker-compose.yaml's own hardcoded postgres/minio
# service credentials exactly, or `docker compose up` can't authenticate
# (found via issue #13's dry run: the old placeholder values here didn't
# match, so the documented `cp .env.example .env` setup never actually
# produced a working stack). Change both files together if you change
# either. POSTGRES_HOST/PORT below are for running the API/worker directly
# on the host against docker-compose's services (ports 5433/6379/9000);
# inside docker-compose itself, api/worker override POSTGRES_HOST to
# "postgres" directly, so these two values are only used outside Compose.
POSTGRES_USER="resolve_user"
POSTGRES_PASSWORD="resolve_password"
POSTGRES_DB="resolve_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"

REDIS_URL="redis://localhost:6379/0"

S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_password"
S3_BUCKET_NAME="evidence-bucket"

API_SECRET_KEY="your_secret_key_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
ENABLE_DEV_ENDPOINTS=False

# Module I: exact origin the frontend is served from (no wildcard)
CORS_ALLOWED_ORIGIN="http://localhost:5173"

# Module J, Category D: Razorpay external API credentials (global, not per-merchant)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_ALLOW_LIVE_MODE=False
